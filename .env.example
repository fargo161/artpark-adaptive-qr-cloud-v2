PORT=3000
NODE_ENV=production
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
ADMIN_KEY=CHANGE-THIS-TO-A-LONG-RANDOM-SECRET
MISSION_CONTROL_PASSPHRASE=CHANGE-THIS-TO-A-SHARED-TEAM-PASSPHRASE
PUBLIC_BASE_URL=https://signal.your-domain.example
# Set to true only if your provider requires it for managed Postgres SSL.
PGSSL=false
